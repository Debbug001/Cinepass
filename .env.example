# Local development settings. Copy this file to .env and replace placeholders.
# Never commit .env or place database credentials in VITE_* variables.

# MySQL connection (local). On Railway, set these to the Railway MySQL service values.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=MOVIE_BOOKING_SYSTEM
DB_PORT=3306

# Express uses PORT automatically on Railway. API_PORT is a local fallback.
API_PORT=5000

# Frontend API base URL. Must end in /api for local development and Vercel builds.
VITE_API_URL=http://localhost:5000/api

# Local frontend origin(s). On Railway, set FRONTEND_URL to your Vercel production origin.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional alternate MySQL connection string; do not set this together with DB_* unless intended.
# DATABASE_URL=mysql://username:password@host:3306/database_name
